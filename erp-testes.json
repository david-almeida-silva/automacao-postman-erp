        {
          "name": "Consulta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status é 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Regra de Negócio: O userId deve ser 1\", function () {\r",
                  "    var resposta = pm.response.json();\r",
                  "    pm.expect(resposta.userId).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Regra de Negócio: A versão do documento deve ser 0\", function () {\r",
                  "    var resposta = pm.response.json();\r",
                  "    pm.expect(resposta.__v).to.eql(0);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://fakestoreapi.com/carts/1",
              "protocol": "https",
              "host": [
                "fakestoreapi",
                "com"
              ],
              "path": [
                "carts",
                "1"
