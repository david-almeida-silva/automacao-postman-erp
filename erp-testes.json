  "item": [
    {
      "name": "Fluxo de Vendas",
      "item": [
        {
          "name": "Enviar Carrinho",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Teste padrão de sucesso\r",
                  "pm.test(\"Produto criado com sucesso (Status 200 ou 201)\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// O PULO DO GATO: Guardar o ID na memória (Variável de Ambiente)\r",
                  "pm.test(\"Capturar o ID gerado pelo ERP\", function () {\r",
                  "    // 1. Lemos a resposta JSON do servidor\r",
                  "    var resposta = pm.response.json();\r",
                  "    \r",
                  "    // 2. Extraímos o ID que o ERP gerou (ex: 21)\r",
                  "    var id_carrinho_Gerado = resposta.id;\r",
                  "    \r",
                  "    // 3. Dizemos ao Postman: \"Guarda este ID numa variável chamada 'id_produto_salvo'\"\r",
                  "    pm.environment.set(\"id_produto_salvo\", id_carrinho_Gerado);\r",
                  "    \r",
                  "    // Apenas para veres no terminal do Postman que funcionou:\r",
                  "    console.log(\"O ID capturado foi: \" + id_carrinho_Gerado);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"userId\": 5,\r\n    \"date\": \"2026-06-18\",\r\n    \"products\": [\r\n        {\"productId\": 1, \"quantity\": 3},\r\n        {\"productId\": 5, \"quantity\": 1}\r\n    ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://fakestoreapi.com/carts",
              "protocol": "https",
              "host": [
                "fakestoreapi",
                "com"
              ],
              "path": [
                "carts"
              ]
            }
          },
          "response": []
        },
