                  "});\r",
                  "\r",
                  "pm.test(\"Capturar e salvar o Token de Acesso\", function () {\r",
                  "    var resposta = pm.response.json();\r",
                  "    \r",
                  "    // Garantimos que a API nos devolveu a palavra 'token'\r",
                  "    pm.expect(resposta.token).to.not.be.undefined;\r",
                  "    \r",
                  "    // Salvamos o token na memória do Postman\r",
                  "    pm.environment.set(\"token_caixa\", resposta.token);\r",
                  "});"
                ],
