        {
          "name": "Deletar Produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"O status retornou 200 (Comportamento da FakeStoreAPI)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"O produto não existe, então a resposta deve ser vazia ou nula\", function () {\r",
                  "    // Como a resposta pode vir totalmente vazia, pegamos ela como texto em vez de JSON\r",
                  "    var respostaTexto = pm.response.text();\r",
                  "    \r",
                  "    // Afirmamos que o texto tem que ser literalmente vazio ('') ou a palavra 'null'\r",
                  "    pm.expect(respostaTexto).to.be.oneOf(['', 'null']);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
